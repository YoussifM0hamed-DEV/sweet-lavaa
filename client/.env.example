# API base URL.
#  - Local development: /api  (the Vite dev server proxies it to the API)
#  - Deployed on a separate host (Vercel): the full API URL,
#    e.g. https://sweet-lavaa.onrender.com/api
VITE_API_URL=/api

# Google OAuth client id (must match GOOGLE_CLIENT_ID on the server)
VITE_GOOGLE_CLIENT_ID=
