# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ─── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/sweet_lava

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_a_random_cookie_secret

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sweet-lava

# ─── Email (order confirmations + password reset) ─────────────────────────
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# Leave empty and the app still works — emails are logged instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display name. Left empty it becomes "Sweet Lava" <SMTP_USER>.
MAIL_FROM=
# Where "new order" alerts go. Defaults to SMTP_USER.
MAIL_NOTIFY=

# ─── Misc ──────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
SEED_ADMIN_EMAIL=admin@sweetlava.com
SEED_ADMIN_PASSWORD=Admin@12345
