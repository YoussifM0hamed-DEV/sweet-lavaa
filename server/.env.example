# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ─── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/sweet_lava

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_a_random_cookie_secret

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sweet-lava

# ─── Fawaterak ─────────────────────────────────────────────────────────────
# Dashboard > Integrations > "HASH API key". It is both the API bearer token
# and the webhook signing secret. The OAuth client on that page is NOT used —
# v2 rejects its tokens with "Invalid Token or inactive vendor".
FAWATERAK_API_KEY=
FAWATERAK_BASE_URL=https://app.fawaterk.com
FAWATERAK_CURRENCY=EGP
# ─── Misc ──────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
SEED_ADMIN_EMAIL=admin@sweetlava.com
SEED_ADMIN_PASSWORD=Admin@12345
